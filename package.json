{
  "name": "@codecloud-dev/moxwebgpu",
  "version": "1.1.3",
  "description": "⚡ A WebGPU compute (GPGPU) framework — typed tensors, raw kernels and a lazy compute graph, with reverse-mode autodiff, in one tiny package.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./browser": "./dist/moxwebgpu.browser.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run --config vitest.config.ts",
    "test:gpu": "bash scripts/run-gpu-tests.sh",
    "test:all": "pnpm test && pnpm test:gpu",
    "bench": "pnpm build && MOXWEBGPU_VITEST_CONFIG=vitest.bench.config.ts bash scripts/run-gpu-tests.sh",
    "demo": "pnpm build && mkdir -p examples/browser && cp dist/moxwebgpu.browser.js examples/browser/ && npx -y serve examples/browser -l 5173"
  },
  "keywords": [
    "webgpu",
    "gpgpu",
    "gpu",
    "compute",
    "tensor",
    "wgsl",
    "typescript",
    "webgl-alternative"
  ],
  "author": "codecloud-dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codecloud-dev/moxwebgpu.git"
  },
  "bugs": {
    "url": "https://github.com/codecloud-dev/moxwebgpu/issues"
  },
  "homepage": "https://github.com/codecloud-dev/moxwebgpu#readme",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@webgpu/types": "^0.1.64",
    "playwright-core": "^1.65.1",
    "tsup": "^9.0.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "overrides": {
      "vite": ">=7.3.7 <8",
      "esbuild": "0.28.2"
    }
  }
}
